    "validate:delivery-integration": "node scripts/run-ts-validation.cjs scripts/validate-delivery-integration.ts",
    "validate:delivery-channels": "node scripts/run-ts-validation.cjs scripts/validate-delivery-channels.ts",
    "validate:scheduled-delivery": "node scripts/run-ts-validation.cjs scripts/validate-scheduled-delivery.ts",
    "validate:tasks": "node scripts/run-ts-validation.cjs scripts/validate-task-runner.ts",
    "validate:deployment": "node scripts/run-ts-validation.cjs scripts/validate-deployment.ts",
    "validate:persistence": "node scripts/run-ts-validation.cjs scripts/validate-persistence.ts",
    "validate:database": "node scripts/run-ts-validation.cjs scripts/validate-database.ts",
    "validate:workflow-hardening": "node scripts/run-ts-validation.cjs scripts/validate-workflow-hardening.ts",
    "validate:operations": "node scripts/run-ts-validation.cjs scripts/validate-operations.ts",
    "validate:content-intelligence": "node scripts/run-ts-validation.cjs scripts/validate-content-intelligence.ts",
    "validate:editorial-enrichment": "node scripts/run-ts-validation.cjs scripts/validate-editorial-enrichment.ts",
    "validate:llm-enrichment": "node scripts/run-ts-validation.cjs scripts/validate-llm-enrichment.ts",
    "validate:prompt-quality": "node scripts/run-ts-validation.cjs scripts/validate-prompt-quality.ts",
    "validate:workspace-boundary": "node scripts/run-ts-validation.cjs scripts/validate-workspace-boundary.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.6.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.20",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
