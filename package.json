{
  "name": "ai-tech-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:candidates": "tsx scripts/sync-external-candidates.ts",
    "gen:favicon": "node scripts/generate-favicon.mjs",
    "db:init": "node scripts/run-ts-validation.cjs scripts/db-init.ts",
    "db:migrate-json": "node scripts/run-ts-validation.cjs scripts/db-migrate-json.ts",
    "db:reset": "node scripts/run-ts-validation.cjs scripts/db-reset.ts",
    "tasks:run-once": "node scripts/run-ts-validation.cjs scripts/tasks-runner.ts run-once",
    "tasks:watch": "node scripts/run-ts-validation.cjs scripts/tasks-runner.ts watch",
    "ui:check": "node scripts/playwright-ui-check.mjs",
    "validate:candidates": "node scripts/run-ts-validation.cjs scripts/validate-candidate-workflow.ts",
    "validate:publishing": "node scripts/run-ts-validation.cjs scripts/validate-candidate-workflow.ts",
    "validate:sources": "node scripts/run-ts-validation.cjs scripts/validate-source-workflow.ts",
    "validate:duplicates": "node scripts/run-ts-validation.cjs scripts/validate-duplicate-workflow.ts",
    "validate:quality": "node scripts/run-ts-validation.cjs scripts/validate-quality-signals.ts",
    "validate:ranking": "node scripts/run-ts-validation.cjs scripts/validate-ranking-workflow.ts",
    "validate:digest": "node scripts/run-ts-validation.cjs scripts/validate-digest-workflow.ts",
