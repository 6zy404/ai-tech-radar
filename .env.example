# Public URL used to build digest/feed links. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Minimal workspace/API protection for controlled deployments.
# Set WORKSPACE_ACCESS_ENABLED=true and provide a strong token before exposing /workspace.
WORKSPACE_ACCESS_ENABLED=false
WORKSPACE_ACCESS_TOKEN=

# Local JSON data directory. Relative paths are resolved from the project root.
LOCAL_DATA_DIR=./config

# Persistence driver. Keep json as the safe default; use sqlite after running db:init/db:migrate-json.
PERSISTENCE_DRIVER=json
SQLITE_DATABASE_PATH=./config/ai-tech-radar.sqlite

# Local task runner interval for npm run tasks:watch.
TASK_RUNNER_INTERVAL_SECONDS=60

# Optional operator references for delivery setup.
# Real endpoints are configured in the Internal Workspace and should not be committed.
DELIVERY_WEBHOOK_ENDPOINT=
FEISHU_WEBHOOK_ENDPOINT=

# Optional server-side LLM provider for workspace editorial enrichment.
# Defaults to mock when no real API key is configured.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
