# Public URL used to build digest/feed links. Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Minimal workspace/API protection for controlled deployments.
# Set WORKSPACE_ACCESS_ENABLED=true and provide a strong token before exposing /workspace.
WORKSPACE_ACCESS_ENABLED=false
WORKSPACE_ACCESS_TOKEN=

# Local JSON data directory. Relative paths are resolved from the project root.
LOCAL_DATA_DIR=./config

# Persistence driver. Keep json as the safe default; use sqlite after running db:init/db:migrate-json.
PERSISTENCE_DRIVER=json
SQLITE_DATABASE_PATH=./config/ai-tech-radar.sqlite

# Local task runner interval for npm run tasks:watch.
TASK_RUNNER_INTERVAL_SECONDS=60

# Optional operator references for delivery setup.
# Real endpoints are configured in the Internal Workspace and should not be committed.
DELIVERY_WEBHOOK_ENDPOINT=
FEISHU_WEBHOOK_ENDPOINT=

# Optional server-side LLM provider. One key serves the workspace (enrichment,
# triage suggestions, AI 起草, AI 起草导语) AND four public, unauthenticated
# routes that spend it per request: POST /api/technologies/{compare,explain,
# learning-path} and POST /api/ask. Review the rate limit at the end of this
# file before setting a real key. Defaults to mock when no key is configured.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
# DeepSeek through the same OpenAI-compatible provider:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# Optional, for a cost figure in `npm run eval:triage` (price per million tokens,
# in whatever currency you want the figure in):
# TRIAGE_PRICE_INPUT_PER_M=
# TRIAGE_PRICE_OUTPUT_PER_M=

# Hybrid search runs a local embedding model (no API key). The first search on
# a fresh deployment downloads it (~130MB) into .cache/models; huggingface.co is
# not reliably reachable here, so the default host is hf-mirror.com.
# EMBEDDING_REMOTE_HOST=https://hf-mirror.com/
# A search waits at most this long for the semantic half, then answers from
# keywords while the model keeps loading in the background.
# SEARCH_SEMANTIC_TIMEOUT_MS=3000
# One attempt to load the embedding model is abandoned and logged after this
# long; the next search retries. Default 120000. See docs/deployment.md ->
# "Health endpoint and uptime alerts".
# EMBEDDING_LOAD_TIMEOUT_MS=120000
# The semantic duplicate pass after each import gives up after this long and
# keeps the last stored matches. Default 60000.
# SEMANTIC_DEDUP_TIMEOUT_MS=60000

# Source fetching during imports: attempts per source (max 5), per-attempt
# timeout (max 120000) and base backoff between attempts (max 30000).
# IMPORT_FETCH_ATTEMPTS=3
# IMPORT_FETCH_TIMEOUT_MS=20000
# IMPORT_FETCH_RETRY_DELAY_MS=800

# Reader push (「有新信号时提醒我」). Off unless both keys are set. Generate the
# pair ONCE with `node scripts/generate-vapid-keys.mjs` and never replace it:
# every existing subscription was made against this public key, and a new pair
# silently stops all of them. Keep a copy off this machine (npm run
# backup:data does not cover .env.local). Never commit real keys.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# Optional contact for the push services, mailto: or https:; anything else
# falls back to NEXT_PUBLIC_SITE_URL.
# PUSH_VAPID_SUBJECT=mailto:you@example.com

# Rate limit for the four public AI routes
# (POST /api/technologies/{compare,explain,learning-path} and POST /api/ask).
# The client key is CF-Connecting-IP, then x-real-ip, then the last hop of
# x-forwarded-for; the routes also require a JSON content type and reject
# cross-site origins.
# Per client, per route. In-memory and per-process — a cost guardrail, not bot
# protection. Review these before configuring a real-cost LLM provider.
PUBLIC_AI_RATE_LIMIT_PER_MINUTE=10
PUBLIC_AI_RATE_LIMIT_PER_HOUR=40
# Site-wide total for the same four routes, all together, per Asia/Shanghai
# day: model calls only (a cache hit does not count); 429 until midnight once
# spent. Kept in config/public-ai-usage.json, so a restart does not reset it.
# Default 500; unset or invalid means the default. Changing it needs a restart.
# PUBLIC_AI_DAILY_LIMIT=500
