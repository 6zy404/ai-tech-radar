# Dependencies
node_modules

# Next.js build output
.next
out

# TypeScript incremental build info
*.tsbuildinfo

# Local SQLite database files
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Environment files (keep .env.example tracked)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
config/task-runner-cron.log
config/backup-cron.log

# Runtime-only local stores: a delivery config that would hold real webhook
# endpoints/tokens once configured (keep it out of git — see
# docs/production-readiness.md -> B2), an append-only audit log, the task-runner
# summary, and regenerable LLM result caches. Content/config/editorial-state
# stores under config/ stay tracked because they seed a deployment.
config/delivery.json
config/workflow-events.json
config/task-runner.json
config/technology-comparisons.json
config/technology-explanations.json
config/technology-learning-paths.json

# OS files
.DS_Store

# Local agent / tooling state (Codex, OMX, Claude Code, visual QA, etc.)
.codex/
.omx/
.claude/
visual-qa-screenshots/

# Temporary artifacts and work-in-progress patches
*.patch
*.dmp
*.pma
